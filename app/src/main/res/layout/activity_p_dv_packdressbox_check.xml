<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent" >

    <LinearLayout
        android:id="@+id/lin_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/titlebar_back"
        android:orientation="horizontal"
        android:paddingBottom="10dp"
        android:paddingTop="10dp" >

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical" >

            <TextView
                android:id="@+id/tv_instock_bill_str"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="套餐名称："
                android:textColor="@color/white"
                android:textSize="30dp" />

            <TextView
                android:id="@+id/tv_PackDressBox_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_toRightOf="@id/tv_instock_bill_str"
                android:text=""
                android:textColor="@color/white"
                android:textSize="30dp" />
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical" >

            <TextView
                android:id="@+id/tv_supplier_str"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="套餐代号："
                android:textColor="@color/white"
                android:textSize="30dp" />

            <TextView
                android:id="@+id/tv_PackDressBox_Code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@id/tv_supplier_str"
                android:text=""
                android:textColor="@color/white"
                android:textSize="30dp" />
        </RelativeLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lin_sacncode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/lin_head"
        android:background="@color/cornflowerblue"
        android:orientation="horizontal" >

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.4"
            android:gravity="center"
            android:paddingBottom="15dp"
            android:paddingTop="15dp"
            android:text="条\t码"
            android:textColor="@color/white"
            android:textSize="30dp" />

        <View
            android:layout_width="1dp"
            android:layout_height="fill_parent"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:background="#696969" />

        <View
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_weight="0.05" />

        <EditText
            android:id="@+id/et_PackDressBox_barcode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2.4"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:inputType="text"
            android:textSize="30dp" >

            <requestFocus />
        </EditText>

        <View
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_weight="0.05" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#A2A2A2"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone" >

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_weight="1.2" >

            <TextView
                android:id="@+id/tv_packing_number_str"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="10dp"
                android:text="盒装数："
                android:textSize="16dp" />

            <TextView
                android:id="@+id/tv_packing_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toRightOf="@+id/tv_packing_number_str"
                android:text="0/0"
                android:textSize="18dp" />

            <Button
                android:id="@+id/btn_set_packing_number"
                android:layout_width="60dp"
                android:layout_height="30dp"
                android:layout_centerVertical="true"
                android:layout_marginRight="5dp"
                android:layout_toRightOf="@+id/tv_packing_number"
                android:background="@drawable/button_background"
                android:text="设置"
                android:visibility="gone" />
        </RelativeLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/lin_Bottom"
        android:layout_below="@+id/lin_sacncode"
        android:orientation="vertical" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" >

            <TextView
                android:id="@+id/tv_PackDressBox_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3"
                android:gravity="center"
                android:padding="7dp"
                android:text="产品ID"
                android:textSize="28dp" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#AEAEAE" />

            <TextView
                android:id="@+id/tv_PackDressBox_Modelm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3"
                android:gravity="center"
                android:padding="7dp"
                android:text="型号"
                android:textSize="28dp" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#AEAEAE" />

            <TextView
                android:id="@+id/tv_PackDressBox_Color"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3"
                android:gravity="center"
                android:padding="7dp"
                android:text="色号"
                android:textSize="28dp" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#AEAEAE" />

            <TextView
                android:id="@+id/tv_PackDressBox_total"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3"
                android:gravity="center"
                android:padding="7dp"
                android:text="产品数量"
                android:textSize="28dp" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#AEAEAE" />

            <TextView
                android:id="@+id/tv_PackDressBox_scannum"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3"
                android:gravity="center"
                android:padding="7dp"
                android:text="当前扫描数量"
                android:textSize="28dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#AEAEAE" />

        <ListView
            android:id="@+id/PackDressBox_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" >
        </ListView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lin_Bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:orientation="vertical"
       >

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#D7D7D7"
            android:paddingBottom="10dp"
            android:paddingTop="10dp" >

            <TextView
                android:id="@+id/tv_connect_state_str"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="50dp"
                android:gravity="center"
                android:text="蓝牙打印机："
                android:textSize="30dp" />

            <TextView
                android:id="@+id/tv_connect_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@id/tv_connect_state_str"
                android:gravity="center"
                android:text="未连接"
                android:textSize="30dp" />

            <TextView
                android:id="@+id/tv_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_marginRight="50dp"
                android:gravity="center"
                android:text="可扫描"
                android:textSize="30dp"
                android:visibility="gone" />
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/titlebar_back"
            android:gravity="center"
            android:paddingBottom="15dp"
            android:paddingTop="15dp" >

            <Button
                android:id="@+id/btn_connect"
                android:layout_width="200dp"
                android:layout_height="60dp"
                android:background="@drawable/button_background2"
                android:text="连接"
                android:textSize="30dp" />

            <Button
                android:id="@+id/btn_scan_detail"
                android:layout_width="200dp"
                android:layout_height="60dp"
                android:layout_marginLeft="30dp"
                android:layout_toRightOf="@id/btn_connect"
                android:background="@drawable/button_background2"
                android:text="扫描明细"
                android:textSize="30dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_scan_print"
                android:layout_width="200dp"
                android:layout_height="60dp"
                android:layout_marginLeft="30dp"
                android:layout_toRightOf="@id/btn_scan_detail"
                android:background="@drawable/button_background2"
                android:text="扫描打印"
                android:textSize="30dp" />

            <Button
                android:id="@+id/btn_again_print_boxcode"
                android:layout_width="200dp"
                android:layout_height="60dp"
                android:layout_marginLeft="30dp"
                android:layout_toRightOf="@id/btn_scan_print"
                android:background="@drawable/button_background2"
                android:text="补打套标"
                android:textSize="30dp" />

            <Button
                android:id="@+id/btn_test_packing"
                android:layout_width="200dp"
                android:layout_height="60dp"
                android:layout_marginLeft="30dp"
                android:layout_toRightOf="@id/btn_again_print_boxcode"
                android:background="@drawable/button_background2"
                android:text="测试打印"
                android:textSize="30dp" />

            <Button
                android:id="@+id/btn_finish"
                android:layout_width="200dp"
                android:layout_height="60dp"
                android:layout_marginLeft="30dp"
                android:layout_toRightOf="@id/btn_test_packing"
                android:background="@drawable/button_background2"
                android:text="完成"
                android:textSize="30dp" />
        </RelativeLayout>
    </LinearLayout>

</RelativeLayout>