<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main6"
    android:orientation="vertical"
    tools:ignore="Uselesdparent,ContentDescription,HardcodedText,DuplicateIds" >

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true" >

        <ImageView
            android:id="@+id/imageView1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentLeft="true"
            android:layout_marginBottom="20dp"
            android:layout_marginLeft="42dp"
            android:src="@drawable/link_state_on" />

        <ImageView
            android:id="@+id/logoimage"
            android:layout_width="250dp"
            android:layout_height="250dp"
             android:layout_marginLeft="150dp"
            android:layout_centerVertical="true"
            android:scaleType="fitXY"
            android:src="@drawable/p00" />

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentRight="true"
            android:layout_marginRight="250dp"
            >

            <Button
                android:id="@+id/btn_setting"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_below="@+id/btn_backgoods"
                android:layout_marginTop="50dp"
                android:layout_marginRight="50dp"
                android:background="@drawable/btn_system6" />

            <Button
                android:id="@+id/btn_otherscan"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_marginTop="50dp"
                android:layout_below="@+id/btn_backgoods"
                android:layout_toRightOf="@+id/btn_setting"
                android:background="@drawable/btn_other6" />

            <Button
                android:id="@+id/btn_sendgoods"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_marginRight="50dp"
                android:background="@drawable/btn_sendgoods6" />

            <Button
                android:id="@+id/btn_backgoods"
               android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_toRightOf="@+id/btn_sendgoods"
                android:background="@drawable/btn_backgoods6" />
        </RelativeLayout>

        <TextView
            android:id="@+id/txt_versionCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_alignParentTop="true"
            android:layout_marginRight="20dp"
            android:layout_marginTop="20dp"
            android:text="V8.10"
            android:textColor="@color/white"
            android:textSize="16dp" />
    </RelativeLayout>

</RelativeLayout>