<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    tools:ignore="TextFields,HardcodedText,InefficientWeight,Uselesdparent,dpUsage" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/titlebar_back"
        android:orientation="horizontal" >

        <LinearLayout
            android:id="@+id/LinearLayout1"
            android:layout_width="350dp"
            android:layout_height="match_parent"
            android:gravity="left|center_vertical"
            android:orientation="horizontal" >

            <TextView
                android:id="@+id/TextView04"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="零售商："
                android:textColor="@color/white"
                android:textSize="17dp" />

            <TextView
                android:id="@+id/txt_company_na"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="深圳光明眼镜"
                android:textColor="@color/white"
                android:textSize="17dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical" >

            <TextView
                android:id="@+id/txtCompany_na"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="单号："
                android:textColor="@color/white"
                android:textSize="17dp" />

            <TextView
                android:id="@+id/txt_billno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2014010100001"
                android:textColor="@color/white"
                android:textSize="17dp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cornflowerblue" >

        <TextView
            android:id="@+id/TextView05"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="条\t码："
            android:textColor="@color/white"
            android:textSize="20dp" />

        <EditText
            android:id="@+id/txt_barcode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="20dp"
            android:layout_weight="1"
            android:ems="10" >

            <requestFocus />
        </EditText>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@color/gray"
        android:gravity="center_vertical" >

        <TextView
            android:id="@+id/TextView06"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="型号色号："
            android:textSize="20dp" />

        <TextView
            android:id="@+id/lbl_productinfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BL9802-C01"
            android:textSize="20dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="2.88"
        android:orientation="horizontal" >

        <include layout="@layout/scan_main_layout"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/LinearLayout01"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/titlebar_back"
        android:gravity="center"
        android:orientation="horizontal" >

        <Button
            android:id="@+id/btn_list"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:text="明细" />

        <Button
            android:id="@+id/btn_print"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="打印" />

        <Button
            android:id="@+id/btn_exit"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="完成" />

    </LinearLayout>

</LinearLayout>