<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:ignore="HardcodedText" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" >

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:paddingBottom="10dp"
            android:paddingTop="10dp" >

            <TextView
                android:id="@+id/txt_list1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="10dp"
                android:text="店名"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textSize="30dp" />

            <TextView
                android:id="@+id/id_brackets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txt_list1"
                android:paddingLeft="10dp"
                android:paddingTop="5dp"
                android:text="（"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textSize="26dp" />

            <TextView
                android:id="@+id/txt_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txt_list1"
                android:layout_toRightOf="@+id/id_brackets"
                android:paddingTop="5dp"
                android:text="代号"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textSize="26dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txt_list1"
                android:layout_toRightOf="@+id/txt_id"
                android:paddingTop="5dp"
                android:text="）"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textSize="26dp" />
        </RelativeLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="fill_parent"
            android:background="#AEAEAE" />

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.8"
            android:paddingBottom="10dp"
            android:paddingTop="10dp" >

            <TextView
                android:id="@+id/txt_list2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="10dp"
                android:text="联系人"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textSize="30dp" />

            <TextView
                android:id="@+id/id_tel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txt_list2"
                android:paddingLeft="10dp"
                android:paddingTop="5dp"
                android:text="（"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textSize="26dp" />

            <TextView
                android:id="@+id/txt_tel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txt_list2"
                android:layout_toRightOf="@+id/id_tel"
                android:paddingTop="5dp"
                android:text="联系电话"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textSize="26dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txt_list2"
                android:layout_toRightOf="@+id/txt_tel"
                android:paddingTop="5dp"
                android:text="）"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textSize="26dp" />
        </RelativeLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="fill_parent"
            android:background="#AEAEAE" />

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.8"
            android:paddingBottom="10dp"
            android:paddingTop="10dp" >

            <TextView
                android:id="@+id/txt_list3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="10dp"
                android:text="直营区名称"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textSize="30dp" />

            <TextView
                android:id="@+id/id_trader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txt_list3"
                android:paddingLeft="10dp"
                android:paddingTop="5dp"
                android:text="（"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textSize="26dp" />

            <TextView
                android:id="@+id/txt_trader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txt_list3"
                android:layout_toRightOf="@+id/id_trader"
                android:paddingTop="5dp"
                android:text="直营区代号"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textSize="26dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txt_list3"
                android:layout_toRightOf="@+id/txt_trader"
                android:paddingTop="5dp"
                android:text="）"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textSize="26dp" />
        </RelativeLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#AEAEAE" />

</LinearLayout>