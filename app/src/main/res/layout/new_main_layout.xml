<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main"
    android:orientation="vertical"
    tools:ignore="Uselesdparent,ContentDescription" >

    <ImageView
        android:id="@+id/imageView1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentLeft="true"
        android:layout_marginBottom="20dp"
        android:layout_marginLeft="42dp"
        android:src="@drawable/link_state_on" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true" >

        <LinearLayout
            android:id="@+id/linearLayout1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:gravity="center" >

            <Button
                android:id="@+id/btn_instock_in"
                android:layout_width="150dp"
                android:layout_height="80dp"
                android:background="@drawable/btn_instock_in_background" />

            <Button
                android:id="@+id/btn_sendgoods_d"
                android:layout_width="150dp"
                android:layout_height="80dp"
                android:layout_marginLeft="50dp"
                android:background="@drawable/btn_sendgoods_d_background" />

            <Button
                android:id="@+id/btn_sendgoods_zy"
                android:layout_width="150dp"
                android:layout_height="80dp"
                android:layout_marginLeft="50dp"
                android:background="@drawable/btn_sendgoods_zy_background" />

            <Button
                android:id="@+id/btn_otherscan"
                android:layout_width="150dp"
                android:layout_height="80dp"
                android:layout_marginLeft="50dp"
                android:background="@drawable/btn_otherscan_background"
                android:visibility="visible" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearLayout2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_below="@id/linearLayout1"
           android:layout_marginTop="25dp"
            android:gravity="center" >

            <Button
                android:id="@+id/btn_instock_back"
                android:layout_width="150dp"
                android:layout_height="80dp"
                
                android:background="@drawable/btn_instock_back_background" />

            <Button
                android:id="@+id/btn_backgoods_d"
                android:layout_width="150dp"
                android:layout_height="80dp"
                android:layout_marginLeft="50dp"
                android:background="@drawable/btn_backgoods_d_background" />

            <Button
                android:id="@+id/btn_backgoods_zy"
                android:layout_width="150dp"
                android:layout_height="80dp"
                android:layout_marginLeft="50dp"
                android:background="@drawable/btn_backgoods_zy_background" />

            <Button
                android:id="@+id/btn_product_logist"
                android:layout_width="150dp"
                android:layout_height="80dp"
                android:layout_marginLeft="50dp"
                android:background="@drawable/btn_seeklogist_background"
                android:visibility="visible" />
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/relayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_below="@id/linearLayout2"
            android:layout_marginTop="50dp"
            android:paddingBottom="150dp"
            android:gravity="center" >

            <Button
                android:id="@+id/btn_set"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/btn_os_set" />

            <TextView
                android:id="@+id/tv_set"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/btn_set"
                android:textSize="26dp"
                android:text="设置"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btn_function"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginLeft="100dp"
                android:layout_marginRight="100dp"
                android:layout_toRightOf="@id/btn_set"
                android:background="@drawable/btn_function" />

            <TextView
                android:id="@+id/tv_function"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/btn_function"
                android:layout_alignLeft="@id/btn_function"
                android:layout_marginLeft="6dp"
                android:layout_marginTop="0dp"
                android:layout_toRightOf="@id/tv_set"
                android:text="功能"
                android:textColor="@color/white"
                android:textSize="26dp" />

            <Button
                android:id="@+id/btn_update"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_toRightOf="@id/btn_function"
                android:background="@drawable/btn_update_b" />

            <TextView
                android:id="@+id/tv_update"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignLeft="@id/btn_update"
                android:layout_below="@id/btn_update"
                android:layout_toRightOf="@id/tv_function"
                android:text="升级"
                android:textSize="26dp"
                android:layout_marginLeft="7dp"
                android:textColor="@color/white" />
        </RelativeLayout>
    </RelativeLayout>

</RelativeLayout>