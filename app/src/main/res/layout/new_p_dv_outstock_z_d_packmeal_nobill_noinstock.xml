    <LinearLayout
        android:id="@+id/lin_Bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:orientation="vertical"
        >

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#D7D7D7"
            android:paddingBottom="10dp"
            android:paddingTop="10dp" >

            <TextView
                android:id="@+id/tv_connect_state_str"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="50dp"
                android:gravity="center"
                android:text="蓝牙打印机："
                android:textSize="30dp" />

            <TextView
                android:id="@+id/tv_connect_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@id/tv_connect_state_str"
                android:gravity="center"
                android:text="未连接"
                android:textSize="30dp" />

            <TextView
                android:id="@+id/tv_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_marginRight="50dp"
                android:gravity="center"
                android:text="可扫描"
                android:textSize="30dp"
                android:visibility="gone" />
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/titlebar_back"
            android:gravity="center"
            android:paddingBottom="15dp"
            android:paddingTop="15dp" >

            <Button
                android:id="@+id/btn_connect"
                android:layout_width="200dp"
                android:layout_height="60dp"
                android:background="@drawable/button_background2"
                android:text="连接"
                android:textSize="30dp" />


            <Button
                android:id="@+id/btn_again_print_boxcode"
                android:layout_width="200dp"
                android:layout_height="60dp"
                android:layout_marginLeft="30dp"
                android:layout_toRightOf="@id/btn_connect"
                android:background="@drawable/button_background2"
                android:text="补打套标"
                android:textSize="30dp" />

            <Button
                android:id="@+id/btn_test_packing"
                android:layout_width="200dp"
                android:layout_height="60dp"
                android:layout_marginLeft="30dp"
                android:layout_toRightOf="@id/btn_again_print_boxcode"
                android:background="@drawable/button_background2"
                android:text="测试打印"
                android:textSize="30dp" />

            <Button
                android:id="@+id/btn_scan_details"
                android:layout_width="200dp"
                android:layout_height="60dp"
                android:layout_marginLeft="30dp"
                android:layout_toRightOf="@id/btn_test_packing"
                android:background="@drawable/button_background2"
                android:text="当前扫描明细"
                android:textSize="30dp" />

<!--            <Button-->
<!--                android:id="@+id/btn_finish"-->
<!--                android:layout_width="200dp"-->
<!--                android:layout_height="60dp"-->
<!--                android:layout_marginLeft="30dp"-->
<!--                android:background="@drawable/button_background2"-->
<!--                android:text="完成"-->
<!--                android:textSize="30dp" />-->

            <Button
                android:id="@+id/btn_print"
                android:layout_width="200dp"
                android:layout_height="60dp"
                android:layout_marginLeft="30dp"
                android:layout_toRightOf="@id/btn_scan_details"
                android:background="@drawable/button_background2"
                android:text="打印"
                android:textSize="30dp" />
        </RelativeLayout>
    </LinearLayout>


</LinearLayout>