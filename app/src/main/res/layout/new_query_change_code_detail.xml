<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText,dpUsage,InefficientWeight,UselessLeaf">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_gravity="center"
        android:background="@drawable/titlebar_back"
        android:orientation="horizontal"
        android:gravity="center_vertical">
		<RelativeLayout 
		    android:layout_width="wrap_content"
		    android:layout_height="fill_parent"
		    >
		     <TextView
            android:id="@+id/textView1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="换标明细查看"
            android:textColor="@color/white"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:layout_centerVertical="true"
            android:layout_marginLeft="10dp"/>
		     <TextView 
            android:id="@+id/tv_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="（共 0 条）"
            android:textColor="@color/white"
            android:textSize="12dp"
            android:layout_marginLeft="20dp"
           android:layout_alignParentBottom="true"/>
		</RelativeLayout>
		<RelativeLayout 
		    android:layout_width="fill_parent"
		    android:layout_height="fill_parent">
		     <EditText
            android:id="@+id/et_search" 
            android:layout_width="250dp"
            android:layout_height="fill_parent"
            android:hint="模糊查找"
            android:layout_marginRight="15dp"
            android:inputType="text"
            android:focusable="true"
            android:ems="18"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:imeOptions="flagNoExtractUi"
            android:layout_alignParentRight="true">
            <requestFocus />
        </EditText>
		</RelativeLayout>
       
         
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@color/burlywood"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView 
            android:id="@+id/tv_new_code_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="新标物流码"
            android:gravity="center"
            android:padding="3dp"
            android:textSize="18dp"/>
        <View 
            android:layout_width="1dp"
            android:layout_height="fill_parent"
            android:background="#AEAEAE"/>
        <TextView 
            android:id="@+id/tv_old_code_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="旧标条码"
            android:gravity="center"
            android:padding="3dp"
            android:textSize="18dp"/>
         <View 
            android:layout_width="1dp"
            android:layout_height="fill_parent"
            android:background="#AEAEAE"/>
        <TextView 
            android:id="@+id/tv_old_code_type_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.6"
            android:text="旧标类型"
            android:gravity="center"
            android:padding="3dp"
            android:textSize="18dp"/>
    </LinearLayout>

    <ListView
        android:id="@+id/listView_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
    </ListView>

</LinearLayout>