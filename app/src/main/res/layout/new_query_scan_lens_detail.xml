<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:ignore="HardcodedText,dpUsage,InefficientWeight,UselessLeaf" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/titlebar_back"
        android:gravity="center_vertical"
        android:orientation="horizontal" >

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:layout_marginTop="10dp" >

            <TextView
                android:id="@+id/textView1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="镜片扫描明细查看"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textColor="@color/white"
                android:textSize="30dp" />

            <TextView
                android:id="@+id/tv_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/textView1"
                android:layout_marginLeft="20dp"
                android:text="（共 0 条）"
                android:textColor="@color/white"
                android:textSize="26dp" />
        </RelativeLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@color/burlywood"
        android:gravity="center"
        android:orientation="horizontal" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" >

            <TextView
                android:id="@+id/txt_list1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.8"
                android:padding="10dp"
                android:text="产品ID"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textSize="30dp" />
            <View
                android:layout_width="1dp"
                android:layout_height="fill_parent"
                android:background="#AEAEAE" />

            <TextView
                android:id="@+id/txt_refractive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.6"
                android:padding="10dp"
                android:text="折射率"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textSize="30dp" />

            <View
                android:layout_width="1dp"
                android:layout_height="fill_parent"
                android:background="#AEAEAE" />

            <TextView
                android:id="@+id/txt_list2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.6"
                android:padding="10dp"
                android:text="球镜"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textSize="30dp" />

            <View
                android:layout_width="1dp"
                android:layout_height="fill_parent"
                android:background="#AEAEAE" />

            <TextView
                android:id="@+id/txt_list3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.6"
                android:padding="10dp"
                android:text="柱镜"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textSize="30dp" />

            <View
                android:layout_width="1dp"
                android:layout_height="fill_parent"
                android:background="#AEAEAE" />

            <TextView
                android:id="@+id/txt_list4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.6"
                android:padding="10dp"
                android:text="数量"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textSize="30dp" />
<!--            <View-->
<!--                android:layout_width="1dp"-->
<!--                android:layout_height="fill_parent"-->
<!--                android:background="#AEAEAE" />-->

<!--            <TextView-->
<!--                android:id="@+id/txt_code"-->
<!--                android:layout_width="0dp"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:layout_weight="1"-->
<!--                android:padding="10dp"-->
<!--                android:text="条码"-->
<!--                android:textAppearance="?android:attr/textAppearanceLarge"-->
<!--                android:textSize="30dp" />-->


        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#AEAEAE" />



    </LinearLayout>

    <ListView
        android:id="@+id/listView1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" >
    </ListView>

</LinearLayout>