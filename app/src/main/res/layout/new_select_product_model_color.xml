<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical" >

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/black"
        android:gravity="left"
        android:paddingLeft="10dp"
        android:text="【选择产品】"
        android:textColor="@color/white"
        android:textSize="30dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/titlebar_back"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="15dp"
        android:paddingTop="15dp" >

        <RelativeLayout
            android:id="@+id/relat_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" >

            <TextView
                android:id="@+id/selected_model_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="选择型号色号"
                android:textColor="@color/white"
                android:textSize="28dp" />

            <TextView
                android:id="@+id/selected_model_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/selected_model_name"
                android:layout_marginLeft="5dp"
                android:text="（已选：）"
                android:textColor="#00FF00"
                android:textSize="20dp" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tv_redownload"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="20dp"
            android:gravity="center"
            android:padding="5dp"
            android:text="重新下载产品"
            android:textSize="22dp"
            android:visibility="visible" />

        <EditText
            android:id="@+id/select_model_et_search"
            android:layout_width="550dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="10dp"
            android:ems="16"
            android:hint="模糊查找"
            android:imeOptions="flagNoExtractUi"
            android:inputType="text"
            android:textSize="28dp" 
            android:padding="15dp" >
        </EditText>

        <Button
            android:id="@+id/select_model_btn_filter"
            android:layout_width="150dp"
            android:layout_height="70dp"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="10dp"
            android:text="筛 选"
            android:textSize="28dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.88"
        android:orientation="vertical" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/burlywood"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="10dp" >

            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_weight="0.8" >

                <TextView
                    android:id="@+id/tv_goodstr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="产品ID"
                    android:textSize="28dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_goodstr"
                    android:text="（品类）"
                    android:layout_marginTop="5dp"
                    android:textSize="24dp" />
            </RelativeLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#AEAEAE" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:padding="5dp"
                android:paddingLeft="10dp"
                android:text="产品描述"
                android:textSize="28dp" />
        </LinearLayout>

        <ListView
            android:id="@+id/select_model_listview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:cacheColorHint="#00000000" >
        </ListView>
    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/titlebar_back"
        android:gravity="center_vertical"
        android:paddingBottom="10dp"
        android:paddingTop="10dp" >

        <TextView
            android:id="@+id/select_model_tv_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_marginLeft="20dp"
            android:gravity="center_vertical"
            android:padding="10dp"
            android:text="共计 0 条"
            android:textColor="@color/white"
            android:textSize="30dp" />

        <Button
            android:id="@+id/select_model_btn_next"
            android:layout_width="250dp"
            android:layout_height="80dp"
            android:layout_marginLeft="50dp"
            android:layout_toRightOf="@id/select_model_tv_count"
            android:text="下一页"
            android:textSize="30dp" />

        <Button
            android:id="@+id/select_model_btn_cancel"
            android:layout_width="250dp"
            android:layout_height="80dp"
            android:layout_marginLeft="50dp"
            android:layout_toRightOf="@id/select_model_btn_next"
            android:text="返回"
            android:textSize="30dp" />

        <Button
            android:id="@+id/select_model_btn_ok"
            android:layout_width="250dp"
            android:layout_height="80dp"
            android:layout_marginLeft="50dp"
            android:layout_toRightOf="@id/select_model_btn_cancel"
            android:text="确 定"
            android:textSize="30dp" />
    </RelativeLayout>

</LinearLayout>