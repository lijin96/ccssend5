<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:ignore="HardcodedText,dpUsage,InefficientWeight,TextFields" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/titlebar_back"
        android:gravity="center_vertical"
        android:orientation="horizontal" >

        <TextView
            android:id="@+id/TextView04"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.5"
            android:gravity="right"
            android:text="供应商："
            android:textColor="@color/white"
            android:textSize="16dp" />

        <TextView
            android:id="@+id/lbl_company_na"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:text=""
            android:textColor="@color/white"
            android:textSize="16dp" />

        <TextView
            android:id="@+id/txtCompany_na"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="单号："
            android:textColor="@color/white"
            android:textSize="16dp" 
            android:paddingLeft="10dp"/>

        <TextView
            android:id="@+id/lbl_billno"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textColor="@color/white"
            android:textSize="16dp" />

        <TextView
            android:id="@+id/textView1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="仓库："
            android:textColor="@color/white"
            android:textSize="16dp" 
            android:paddingLeft="10dp"/>

        <TextView
            android:id="@+id/txt_stock_na"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textColor="@color/white"
            android:textSize="16dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cornflowerblue" >

        <TextView
            android:id="@+id/TextView05"
           android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="0.42"
            android:text="条\t\t码 "
            android:textColor="@color/white"
            android:textSize="20dp" 
            android:gravity="center"/>
         <View
            android:layout_width="1dp"
            android:layout_height="fill_parent"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:background="#696969" />
         <View
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_weight="0.05" />

        <EditText
            android:id="@+id/txt_barcode"
           android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2.35"
            android:ems="18"
            android:inputType="text" >

            <requestFocus />
        </EditText>
        <View
            android:layout_width="1dp"
            android:layout_height="fill_parent" />

        <View
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_weight="0.1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#A2A2A2"
        android:gravity="fill_horizontal|center_vertical" >

        <TextView
            android:id="@+id/TextView06"
             android:layout_width="93dp"
            android:layout_height="wrap_content"
            android:text="型号色号"
            android:textSize="20dp" 
            android:gravity="center"/>
         <View
            android:layout_width="1dp"
            android:layout_height="fill_parent"
            android:layout_marginRight="2dp"
            android:background="#696969" />

        <TextView
            android:id="@+id/lbl_productinfo"
            android:layout_width="190dp"
            android:layout_height="wrap_content"
            android:text="请选择型号色号！>>>"
            android:textSize="18dp" />

        <Button
            android:id="@+id/btn_select_product_id"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            
            android:text="选择 " />
         <View
            android:layout_width="1dp"
            android:layout_height="fill_parent"
            android:layout_marginLeft="2dp"
            android:background="#696969" />

        <TextView
            android:id="@+id/TextView08"
            android:layout_width="82dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="盒装数量"
            android:textSize="20dp" />
          <View
            android:layout_width="1dp"
            android:layout_height="fill_parent"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:background="#696969" />

        <EditText
            android:id="@+id/txtnum"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="2dp"
            android:gravity="center"
            android:inputType="number"
            android:text="0"
            android:textSize="22dp" />

        <Button
            android:id="@+id/btn_set"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            
            android:text="设置" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="2.88"
        android:orientation="horizontal" >

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical" >

            <TextView
                android:id="@+id/TextView07"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#D7D7D7"
                android:gravity="center"
                android:text="此型号累计"
                android:textSize="40dp" />

            <TextView
                android:id="@+id/lbl_sum"
                android:layout_width="match_parent"
                android:layout_height="fill_parent"
                android:gravity="center"
                android:text="9999"
                android:textColor="@color/darkgreen"
                android:textSize="40dp" />
        </LinearLayout>

        <View
            android:layout_width="2dp"
            android:layout_height="fill_parent"
            android:background="#AEAEAE" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical" >

            <TextView
                android:id="@+id/TextView09"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#D7D7D7"
                android:gravity="center"
                android:text="合\t计"
                android:textSize="40dp" />

            <TextView
                android:id="@+id/lbl_total"
                android:layout_width="match_parent"
                android:layout_height="fill_parent"
                android:gravity="center"
                android:text="9999"
                android:textSize="40dp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/LinearLayout01"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/titlebar_back"
        android:gravity="center"
        android:orientation="horizontal" >

        <Button
            android:id="@+id/btn_list"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            
            android:text="明细" />

        <Button
            android:id="@+id/btn_boxprint"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            
            android:text="盒标打印" />

        <Button
            android:id="@+id/btn_print"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            
            android:text="打印" />

        <Button
            android:id="@+id/btn_exit"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            
            android:text="完成" />
    </LinearLayout>

</LinearLayout>