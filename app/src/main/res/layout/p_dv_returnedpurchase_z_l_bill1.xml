<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText,dpUsage,InefficientWeight,UselessLeaf">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/titlebar_back"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/LinearLayout1"
            android:layout_width="250dp"
            android:layout_height="match_parent"
            android:gravity="left|center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/TextView04"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="直营店："
                android:textColor="@color/white"
                android:textSize="18dp"/>

            <TextView
                android:id="@+id/lbl_company_na"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/white"
                android:textSize="18dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="200dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtCompany_na"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="单号："
                android:textColor="@color/white"
                android:textSize="18dp"/>

            <TextView
                android:id="@+id/lbl_billno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/white"
                android:textSize="18dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center">

            <TextView
                android:id="@+id/textView1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:text="仓库："
                android:textSize="18dp"/>

            <TextView
                android:id="@+id/txt_stock_na"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:text=""
                android:textSize="18dp"/>
        </LinearLayout>
    </LinearLayout>

  <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cornflowerblue"
        android:orientation="horizontal" >

        <TextView
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="0.5"
            android:gravity="center"
            android:text="条\t\t码"
            android:textSize="20dp"
             android:textColor="@color/white"/>

        <View
            android:layout_width="1dp"
            android:layout_height="fill_parent"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:background="#696969" />
		  <View
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_weight="0.05" />
        <EditText
            android:id="@+id/txt_barcode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2.35"
            android:ems="18"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:inputType="text"
            android:imeOptions="actionSend"
            android:textSize="18dp" >

            <requestFocus />
        </EditText>

        <View
            android:layout_width="1dp"
            android:layout_height="fill_parent" />

        <View
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_weight="0.1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@color/gray"
        android:gravity="center_vertical">

       <LinearLayout 
		    android:layout_width="0dp"
		    android:layout_weight="1"
		    android:layout_height="fill_parent"
		    android:orientation="horizontal"
		    android:gravity="center_vertical">
		     <TextView
            android:id="@+id/TextView06"
            android:layout_width="0dp"
            android:layout_weight="0.51"
            android:layout_height="wrap_content"
            android:text="型号色号"
            android:textSize="20dp"
            android:gravity="center"/>
		       <View
            android:layout_width="1dp"
            android:layout_height="fill_parent"
            android:background="#696969" 
            android:layout_marginLeft="1dp"/>

        <TextView
            android:id="@+id/lbl_productinfo"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="BL9802-C01"
            android:textSize="18dp"
            android:paddingLeft="2dp"/>
		    
		</LinearLayout>
		<View
            android:layout_width="1dp"
            android:layout_height="fill_parent"
            android:background="#696969" />
        <LinearLayout 
		    android:layout_width="0dp"
		    android:layout_weight="1"
		    android:layout_height="fill_parent"
		    android:orientation="horizontal"
		    android:gravity="center_vertical">
           <TextView
            android:id="@+id/TextView08"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="盒装数量"
            android:textSize="20dp" />
          <View
            android:layout_width="1dp"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:layout_height="fill_parent"
            android:background="#696969" />

        <EditText
            android:id="@+id/txtnum"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="2dp"
            android:gravity="center"
            android:inputType="number"
            android:text="0"
            android:textSize="30dp" />

        <Button
            android:id="@+id/btn_set"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            
            android:text="设置" />
		    
		</LinearLayout>
    </LinearLayout>

     <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="2.88"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/TextView07"
               android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="此型号累计"
                android:textSize="40dp"
                android:gravity="center"
                android:background="#D7D7D7"/>

            <TextView
                android:id="@+id/lbl_sum"
                android:layout_width="match_parent"
                android:layout_height="fill_parent"
                android:gravity="center"
                android:text="9999"
                android:textColor="@color/darkgreen"
                android:textSize="40dp"/>
        </LinearLayout>
 <View
                android:layout_width="2dp"
                android:layout_height="fill_parent"
                android:background="#AEAEAE" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/TextView09"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="合\t计"
                android:textSize="40dp"
                android:gravity="center"
                android:background="#D7D7D7"/>

            <TextView
                android:id="@+id/lbl_total"
                android:layout_width="match_parent"
                android:layout_height="fill_parent"
                android:gravity="center"
                android:text="9999"
                android:textSize="40dp"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/LinearLayout01"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/titlebar_back"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_list"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:text="明细"/>
          <Button
            android:id="@+id/btn_boxprint"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="盒标打印" />

        <Button
            android:id="@+id/btn_print"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="打印"/>

        <Button
            android:id="@+id/btn_exit"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="完成"/>
    </LinearLayout>

</LinearLayout>