<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/LinearLayout2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="horizontal"
    tools:ignore="TextFields,HardcodedText,InefficientWeight,Uselesdparent,dpUsage,DisableBaselineAlignment,NestedWeights" >

    <LinearLayout
        android:id="@+id/panMain"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:orientation="vertical" >

        <LinearLayout
            android:id="@+id/panT"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginLeft="0dp"
            android:layout_weight="1"
            android:background="@drawable/titlebar_back"
            android:gravity="center"
            android:orientation="horizontal" >

            <LinearLayout
                android:id="@+id/LinearLayout1"
                android:layout_width="280dp"
                android:layout_height="match_parent"
                android:gravity="left|center_vertical"
                android:orientation="horizontal" >

                <TextView
                    android:id="@+id/TextView04"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:text="直营店："
                    android:textColor="@color/white"
                    android:textSize="15dp" />

                <TextView
                    android:id="@+id/lbl_company_na"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="15dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="200dp"
                android:layout_height="match_parent"
                android:gravity="center_vertical" >

                <TextView
                    android:id="@+id/txtCompany_na"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="单号："
                    android:textColor="@color/white"
                    android:textSize="15dp" />

                <TextView
                    android:id="@+id/lbl_billno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="15dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center" >

                <TextView
                    android:id="@+id/textView1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="仓库："
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/txt_stock_na"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/white" />
            </LinearLayout>

            <Button
                android:id="@+id/btnMenu"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="10dp"
                android:layout_weight="1.09"
                android:text="…" />
        </LinearLayout>

        <EditText
            android:id="@+id/editText1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ems="10" >

            <requestFocus />
        </EditText>

        <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TextView" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/panMenu"
        android:layout_width="131dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="0dp"
        android:background="@drawable/titlebar_back"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible" >

        <Button
            android:id="@+id/btn_list"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:text="明细" />

        <Button
            android:id="@+id/btn_print"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:text="打印" />

        <Button
            android:id="@+id/btn_exit"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:text="完成" />
    </LinearLayout>

</LinearLayout>