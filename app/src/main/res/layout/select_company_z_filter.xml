<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical" 
    android:gravity="center"
    android:background="#D3D3D3"
    android:paddingLeft="10dp">
   <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="20dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_product_name_filfter"
                android:layout_width="65dp"
                android:layout_height="wrap_content"
                android:text="直营区"
                android:textSize="20dp"
                android:textColor="@color/black"/>

            <Spinner
                android:id="@+id/Spinner_area_filfter"
                android:layout_width="330dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                
                />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="20dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_province_filfter"
                android:layout_width="65dp"
                android:layout_height="wrap_content"
                android:text="省   份"
                android:textColor="@color/black"
                android:textSize="20dp"/>

            <Spinner
                android:id="@+id/Spinner_province_filfter"
                android:layout_width="330dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                
                />
        </LinearLayout>
         <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="20dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_city_filfter"
                android:layout_width="65dp"
                android:layout_height="wrap_content"
                android:text="城   市"
                android:textColor="@color/black"
                android:textSize="20dp"/>

            <Spinner
                android:id="@+id/Spinner_city_filfter"
                android:layout_width="330dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                />
        </LinearLayout>

</LinearLayout>
