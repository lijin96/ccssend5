<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:background="@drawable/bottombar_back_button">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_centerVertical="true"
            android:orientation="vertical">
            <TextView
                android:id="@+id/textView1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="请选择要装盒的型号色号"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textColor="@color/white" />
            <TextView
                android:id="@+id/tv_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="（共0条）"
                android:textColor="@color/white"
                android:textSize="18dp"
                android:layout_marginTop="5dp"
                android:layout_below="@+id/textView1"
                />
        </LinearLayout>
        <EditText
            android:id="@+id/et_search"
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/btn_search"
            android:layout_marginRight="10dp"
            android:paddingLeft="5dp"
            android:layout_centerVertical="true"

            android:hint="产品代号或名称模糊搜索查询"
            android:imeOptions="flagNoExtractUi"
            android:inputType="text" />

        <Button
            android:id="@+id/btn_search"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="10dp"
            android:layout_centerVertical="true"

            android:text="搜索" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="left"
        android:background="@color/burlywood">
        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/item_list_factorygoods"/>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ListView
            android:id="@+id/listView1"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
        </ListView>

        <TextView
            android:id="@+id/tv_empty_prompt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/factorygoods_empty_tip"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textColor="@color/black"
            android:background="@color/white"
            android:visibility="gone" />
    </FrameLayout>


</LinearLayout>